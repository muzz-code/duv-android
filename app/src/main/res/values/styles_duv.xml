<?xml version="1.0" encoding="utf-8"?>
<!-- DUV component styles. Spacing 4/8/12/16/24/32 · radius 12 inputs, 14 buttons, 20 cards · touch targets ≥ 48dp. -->
<resources>
    <!-- Type scale -->
    <style name="Duv.Text.Display" parent="">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/duv_text</item>
    </style>
    <style name="Duv.Text.Headline" parent="">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/duv_text</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>
    <style name="Duv.Text.Title" parent="">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/duv_text</item>
    </style>
    <style name="Duv.Text.Body" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/duv_text_muted</item>
        <item name="android:lineSpacingExtra">5sp</item>
    </style>
    <style name="Duv.Text.Label" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/duv_primary</item>
    </style>

    <!-- Buttons -->
    <style name="Duv.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/duv_primary</item>
        <item name="android:textColor">@color/duv_on_primary</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Duv.Button.Light">
        <item name="backgroundTint">@color/duv_surface</item>
        <item name="android:textColor">@color/duv_primary</item>
    </style>
    <style name="Duv.Button.OutlinedLight" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/duv_on_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/duv_on_primary</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Duv.Button.Google" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/duv_outline</item>
        <item name="backgroundTint">@color/duv_surface</item>
        <item name="android:textColor">@color/duv_text</item>
        <item name="icon">@drawable/google_icon</item>
        <item name="iconTint">@null</item>
        <item name="iconSize">20dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Inputs: label above the box (hint shown inside), error text below -->
    <style name="Duv.Input" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/duv_surface</item>
        <item name="boxStrokeColor">@color/duv_primary</item>
        <item name="boxStrokeErrorColor">@color/duv_error</item>
        <item name="errorTextColor">@color/duv_error</item>
        <item name="startIconTint">@color/duv_text_muted</item>
        <item name="endIconTint">@color/duv_text_muted</item>
        <item name="hintEnabled">false</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>
    <style name="Duv.InputText" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/duv_text</item>
        <item name="android:textColorHint">@color/duv_hint</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>
    <style name="Duv.FieldLabel" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/duv_text</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <!-- Cards -->
    <style name="Duv.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/duv_card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/duv_surface</item>
    </style>
</resources>
