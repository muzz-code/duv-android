<?xml version="1.0" encoding="utf-8"?>
<!-- White header with a soft shadow: back arrow on the left, screen title. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_setup_header"
    android:paddingBottom="@dimen/setup_header_shadow">

    <ImageButton
        android:id="@+id/setup_back"
        android:layout_width="@dimen/setup_header_back_touch"
        android:layout_height="@dimen/setup_header_height"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:paddingStart="@dimen/setup_header_back_start"
        android:scaleType="center"
        android:src="@drawable/ic_setup_back"
        tools:ignore="RtlSymmetry"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/setup_header_title"
        style="@style/Setup.Title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/setup_header_height"
        android:layout_marginStart="@dimen/setup_header_title_start"
        android:gravity="center_vertical" />
</FrameLayout>
