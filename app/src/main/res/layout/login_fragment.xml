<?xml version="1.0" encoding="utf-8"?>
<!-- Design: Figma "DUV Live" → 02 · Improved → Log in -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/duv_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_duv_back"
            app:tint="@color/duv_text"
            android:onClick="onDuvBackPressed" />

        <ImageView
            android:id="@+id/login_fragment_login_logo"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:contentDescription="DUV Live"
            android:scaleType="fitStart"
            android:src="@drawable/duv_red_logo" />

        <TextView
            android:id="@+id/login_fragment_login_text_view"
            style="@style/Duv.Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Welcome back" />

        <TextView
            android:id="@+id/login_fragment_duv_text_view"
            style="@style/Duv.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log in to manage your bookings." />
        <TextView android:id="@+id/login_fragment_live_text_view" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        <TextView
            style="@style/Duv.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/login_fragment_email_address_edit_text"
            android:text="Email address" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayout3"
            style="@style/Duv.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:startIconDrawable="@drawable/ic_duv_mail">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/login_fragment_email_address_edit_text"
                style="@style/Duv.InputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="you@example.com"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Duv.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/login_fragment_password_edit_text"
            android:text="Password" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/login_fragment_password_text_Input"
            style="@style/Duv.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:startIconDrawable="@drawable/ic_duv_lock"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/login_fragment_password_edit_text"
                style="@style/Duv.InputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Your password"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/login_fragment_forgot_password_text_view"
            style="@style/Duv.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:text="Forgot password?" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/login_fragment_login_button"
            style="@style/Duv.Button"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:text="Log in" />

        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/duv_outline" />
            <TextView
                android:id="@+id/login_fragment_or_text_view"
                style="@style/Duv.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="or" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/duv_outline" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/login_fragment_login_with_google_text_view"
            style="@style/Duv.Button.Google"
            android:layout_width="match_parent"
            android:text="Continue with Google" />
        <ImageView
            android:id="@+id/login_fragment_google_icon_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/login_fragment_not_registered_create_account_text_view"
            style="@style/Duv.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="Not Registered? create an account" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
