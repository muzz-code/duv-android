<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Bank Account Details" card. The dialog window sets the width (screen minus @dimen/setup_dialog_margin each side). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_setup_dialog"
    android:orientation="vertical"
    android:paddingStart="@dimen/setup_dialog_padding"
    android:paddingTop="@dimen/setup_dialog_title_top"
    android:paddingEnd="@dimen/setup_dialog_padding"
    android:paddingBottom="@dimen/setup_dialog_bottom">

    <TextView
        android:id="@+id/dialog_title"
        style="@style/Setup.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/setup_dialog_title_inset"
        android:text="@string/bank_account_details" />

    <!-- Bank first, then the number: once both are in, the bank fills in the account name (read-only). -->
    <EditText
        android:id="@+id/bank_name"
        style="@style/Setup.Field.Dropdown"
        android:layout_marginTop="@dimen/setup_dialog_title_gap"
        android:hint="@string/setup_hint_bank_name" />

    <EditText
        android:id="@+id/bank_account_number"
        style="@style/Setup.Field"
        android:hint="@string/setup_hint_account_number"
        android:inputType="number"
        android:maxLength="10" />

    <EditText
        android:id="@+id/bank_account_name"
        style="@style/Setup.Field.Picker"
        android:clickable="false"
        android:hint="@string/setup_hint_account_name" />

    <TextView
        android:id="@+id/bank_lookup_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/setup_status_gap"
        android:drawablePadding="@dimen/setup_status_gap"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical"
        android:textSize="@dimen/setup_text_status"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/setup_dialog_button_gap">

        <TextView
            android:id="@+id/dialog_back"
            style="@style/Setup.DialogBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/setup_dialog_back_inset" />

        <Button
            android:id="@+id/dialog_update"
            style="@style/Setup.Button"
            android:layout_width="@dimen/setup_dialog_button_width"
            android:layout_gravity="end"
            android:layout_marginEnd="@dimen/setup_dialog_back_inset"
            android:text="@string/setup_update"
            android:textSize="@dimen/setup_text_small_button" />
    </FrameLayout>
</LinearLayout>
