<?xml version="1.0" encoding="utf-8"?>
<!-- Set-up step 4 (Figma "Entertainer's Account Setup > Emergency Contact"): next of kin and a professional
     contact. The header stays fixed while the form scrolls beneath it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/setup_surface"
    tools:context="com.ebookfrenzy.duvproject.ui.entertainer.EmergencyContactFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/setup_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/setup_screen_margin"
            android:paddingTop="@dimen/setup_header_height"
            android:paddingEnd="@dimen/setup_screen_margin"
            android:paddingBottom="@dimen/setup_bottom_space">

            <TextView
                android:id="@+id/emergency_heading_kin"
                style="@style/Setup.Heading"
                android:layout_marginTop="@dimen/setup_section_top"
                android:text="@string/setup_next_of_kin" />

            <EditText
                android:id="@+id/kin_first_name"
                style="@style/Setup.Field"
                android:layout_marginTop="@dimen/setup_heading_gap"
                android:hint="@string/setup_hint_first_name"
                android:inputType="textPersonName|textCapWords" />

            <EditText
                android:id="@+id/kin_last_name"
                style="@style/Setup.Field"
                android:hint="@string/setup_hint_last_name"
                android:inputType="textPersonName|textCapWords" />

            <EditText
                android:id="@+id/kin_email"
                style="@style/Setup.Field"
                android:hint="@string/setup_hint_email"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/kin_phone"
                style="@style/Setup.Field"
                android:hint="@string/setup_hint_phone"
                android:inputType="phone" />

            <EditText
                android:id="@+id/kin_relationship"
                style="@style/Setup.Field.Dropdown"
                android:hint="@string/setup_hint_relationship" />

            <TextView
                android:id="@+id/emergency_heading_professional"
                style="@style/Setup.Heading"
                android:layout_marginTop="@dimen/setup_section_gap"
                android:text="@string/setup_professional_contact" />

            <EditText
                android:id="@+id/pro_first_name"
                style="@style/Setup.Field"
                android:layout_marginTop="@dimen/setup_heading_gap"
                android:hint="@string/setup_hint_first_name"
                android:inputType="textPersonName|textCapWords" />

            <EditText
                android:id="@+id/pro_last_name"
                style="@style/Setup.Field"
                android:hint="@string/setup_hint_last_name"
                android:inputType="textPersonName|textCapWords" />

            <EditText
                android:id="@+id/pro_email"
                style="@style/Setup.Field"
                android:hint="@string/setup_hint_email"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/pro_phone"
                style="@style/Setup.Field"
                android:hint="@string/setup_hint_phone"
                android:inputType="phone" />

            <EditText
                android:id="@+id/pro_relationship"
                style="@style/Setup.Field.Dropdown"
                android:hint="@string/setup_hint_relationship" />

            <Button
                android:id="@+id/emergency_update"
                style="@style/Setup.Button"
                android:layout_marginTop="@dimen/setup_button_gap"
                android:text="@string/setup_update_contact" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/setup_header"
        layout="@layout/setup_header" />
</FrameLayout>
