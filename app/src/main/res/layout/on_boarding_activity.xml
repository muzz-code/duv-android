<?xml version="1.0" encoding="utf-8"?>
<!-- Design: Figma "DUV Live" → 02 · Improved → Onboarding -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/duv_background"
    tools:context="com.ebookfrenzy.duvproject.ui.onboarding.OnBoardingActivity">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/on_boarding_activity_tab_layout"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:background="@android:color/transparent"
        app:tabBackground="@drawable/bg_duv_onboarding_segment"
        app:tabGravity="start"
        app:tabIndicatorHeight="0dp"
        app:tabMaxWidth="18dp"
        app:tabMinWidth="18dp"
        app:tabPaddingEnd="4dp"
        app:tabPaddingStart="4dp"
        app:layout_constraintBottom_toBottomOf="@id/on_boarding_activity_skip_text_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/on_boarding_activity_skip_text_view" />

    <TextView
        android:id="@+id/on_boarding_activity_skip_text_view"
        style="@style/Duv.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:text="Skip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/screenPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/find_event_fragment_next_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/on_boarding_activity_skip_text_view" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/find_event_fragment_next_button"
        style="@style/Duv.Button"
        android:layout_width="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:text="Next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
