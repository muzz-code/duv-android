<?xml version="1.0" encoding="utf-8"?>
<!-- Set-up step 1 (Figma "Entertainer's Account Setup > Entertainer Profile"). The header stays fixed while the
     form scrolls beneath it, so the form starts with the header's height as top padding. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/setup_surface"
    tools:context="com.ebookfrenzy.duvproject.ui.entertainer.EntertainerProfileFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/setup_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/setup_screen_margin"
            android:paddingTop="@dimen/setup_header_height"
            android:paddingEnd="@dimen/setup_screen_margin"
            android:paddingBottom="@dimen/setup_bottom_space">

            <FrameLayout
                android:layout_width="@dimen/setup_photo_size"
                android:layout_height="@dimen/setup_photo_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="@dimen/setup_photo_nudge"
                android:layout_marginTop="@dimen/setup_photo_top">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/profile_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/img_setup_photo_placeholder"
                    app:civ_circle_background_color="@color/setup_photo_placeholder" />

                <ImageView
                    android:id="@+id/profile_photo_camera"
                    android:layout_width="@dimen/setup_camera_badge"
                    android:layout_height="@dimen/setup_camera_badge"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="@dimen/setup_camera_badge_end"
                    android:layout_marginBottom="@dimen/setup_camera_badge_bottom"
                    android:background="@drawable/bg_setup_camera_badge"
                    android:contentDescription="@string/setup_change_photo"
                    android:padding="@dimen/setup_camera_badge_padding"
                    android:src="@drawable/ic_setup_camera" />
            </FrameLayout>

            <EditText
                android:id="@+id/profile_stage_name"
                style="@style/Setup.Field"
                android:layout_marginTop="@dimen/setup_photo_gap"
                android:hint="@string/setup_hint_stage_name"
                android:inputType="textPersonName|textCapWords" />

            <EditText
                android:id="@+id/profile_type"
                style="@style/Setup.Field.Dropdown"
                android:hint="@string/setup_hint_entertainment_type" />

            <EditText
                android:id="@+id/profile_location"
                style="@style/Setup.Field.Dropdown"
                android:hint="@string/setup_hint_location" />

            <EditText
                android:id="@+id/profile_lga"
                style="@style/Setup.Field.Dropdown"
                android:hint="@string/setup_hint_lga" />

            <EditText
                android:id="@+id/profile_base_charge"
                style="@style/Setup.Field.Dropdown"
                android:hint="@string/setup_hint_base_charge" />

            <EditText
                android:id="@+id/profile_highest_charge"
                style="@style/Setup.Field.Dropdown"
                android:hint="@string/setup_hint_highest_charge" />

            <EditText
                android:id="@+id/profile_travel"
                style="@style/Setup.Field.Dropdown"
                android:hint="@string/setup_hint_travel" />

            <EditText
                android:id="@+id/profile_year"
                style="@style/Setup.Field.Dropdown"
                android:hint="@string/setup_hint_year" />

            <EditText
                android:id="@+id/profile_available_for"
                style="@style/Setup.Field.Picker"
                android:hint="@string/setup_hint_available_for" />

            <EditText
                android:id="@+id/profile_about"
                style="@style/Setup.Field"
                android:hint="@string/setup_hint_about"
                android:inputType="textCapSentences" />

            <Button
                android:id="@+id/profile_update"
                style="@style/Setup.Button"
                android:layout_marginTop="@dimen/setup_button_gap"
                android:text="@string/setup_update_profile" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/setup_header"
        layout="@layout/setup_header" />
</FrameLayout>
