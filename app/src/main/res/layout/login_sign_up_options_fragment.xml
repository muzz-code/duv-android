<?xml version="1.0" encoding="utf-8"?>
<!-- Design: Figma "DUV Live" → 02 · Improved → Welcome -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/duv_primary_dark"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingBottom="32dp"
    tools:context="com.ebookfrenzy.duvproject.ui.auth.LoginSignUpOptionsFragment">

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <ImageView
        android:id="@+id/login_fragment_duv_logo_image_view"
        android:layout_width="96dp"
        android:layout_height="64dp"
        android:contentDescription="DUV Live"
        android:src="@drawable/duv_red_logo"
        android:tint="@color/duv_accent" />

    <TextView
        android:id="@+id/login_sign_up_fragment_duv_text_view"
        style="@style/Duv.Text.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="DUV LIVE"
        android:textColor="@color/duv_on_primary" />

    <TextView
        android:id="@+id/login_sign_up_fragment_live_text_view"
        style="@style/Duv.Text.Body"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Hire entertainers or get hired — all in one place."
        android:textColor="@color/duv_on_dark_muted" />

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/login_sign_up_options_fragment_sign_up_button"
        style="@style/Duv.Button.Light"
        android:layout_width="match_parent"
        android:text="Create account" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/login_sign_up_options_fragment_login_button"
        style="@style/Duv.Button.OutlinedLight"
        android:layout_width="match_parent"
        android:layout_marginTop="12dp"
        android:text="Log in" />

    <TextView
        style="@style/Duv.Text.Body"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="By continuing you agree to our Terms and Privacy Policy"
        android:textColor="@color/duv_on_dark_muted"
        android:textSize="12sp" />
</LinearLayout>
