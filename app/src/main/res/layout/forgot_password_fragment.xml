<?xml version="1.0" encoding="utf-8"?>
<!-- Design: Figma "DUV Live" → 02 · Improved → Forgot password -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/duv_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_duv_back"
            app:tint="@color/duv_text"
            android:onClick="onDuvBackPressed" />

        <ImageView
            android:id="@+id/forgot_password_email_image_view"
            android:layout_width="160dp"
            android:layout_height="130dp"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitStart"
            android:src="@drawable/email_pic" />

        <TextView
            android:id="@+id/forgot_password_fragment_forgot_password_text_view"
            style="@style/Duv.Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Reset your password" />

        <TextView
            android:id="@+id/forgot_password_dummy_text_view"
            style="@style/Duv.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter the email you signed up with and we'll send you a reset link. It expires in 30 minutes." />

        <TextView
            style="@style/Duv.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/login_fragment_password_edit_text"
            android:text="Email address" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/forgot_password_fragment_password_text_Input"
            style="@style/Duv.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:startIconDrawable="@drawable/ic_duv_mail">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/login_fragment_password_edit_text"
                style="@style/Duv.InputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="you@example.com"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/forgot_password_send_button"
            style="@style/Duv.Button"
            android:layout_width="match_parent"
            android:layout_marginTop="24dp"
            android:text="Send reset link" />

        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="24dp" />

        <TextView
            android:id="@+id/textView"
            style="@style/Duv.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="Remembered it? Log in" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
