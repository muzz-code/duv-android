<?xml version="1.0" encoding="utf-8"?>
<!-- Entertainer set-up checklist (Figma "Entertainer's Account Setup > Dashboard"). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/setup_background"
    tools:context="com.ebookfrenzy.duvproject.ui.entertainer.DashboardFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/setup_screen_margin"
        android:paddingTop="@dimen/setup_dashboard_top"
        android:paddingEnd="@dimen/setup_screen_margin"
        android:paddingBottom="@dimen/setup_bottom_space">

        <TextView
            android:id="@+id/setup_title"
            style="@style/Setup.Heading"
            android:layout_width="match_parent"
            android:text="@string/setup_title"
            app:lineHeight="@dimen/setup_line_title" />

        <TextView
            android:id="@+id/setup_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/setup_intro_gap"
            android:fontFamily="@font/poppins_medium"
            android:includeFontPadding="false"
            android:letterSpacing="-0.025"
            android:text="@string/setup_intro"
            android:textColor="@color/setup_intro"
            android:textSize="@dimen/setup_text_body"
            app:lineHeight="@dimen/setup_line_body" />

        <!-- Progress card (Figma "Account set-up progress"): status, "x of 5 steps done", bar and what's next.
             Hidden until the profile has loaded. -->
        <LinearLayout
            android:id="@+id/setup_progress_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/setup_card_gap"
            android:background="@drawable/bg_setup_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/setup_card_padding"
            android:paddingTop="@dimen/setup_card_padding_top"
            android:paddingEnd="@dimen/setup_card_padding"
            android:paddingBottom="@dimen/setup_card_padding_bottom"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_medium"
                    android:includeFontPadding="false"
                    android:text="@string/setup_progress_label"
                    android:textColor="@color/setup_heading"
                    android:textSize="@dimen/setup_text_card_label" />

                <TextView
                    android:id="@+id/setup_progress_stage"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/setup_chip_height"
                    android:background="@drawable/bg_setup_chip"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="@dimen/setup_chip_padding"
                    android:paddingEnd="@dimen/setup_chip_padding"
                    android:textSize="@dimen/setup_text_chip" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setup_card_line_gap"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/setup_progress_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_semibold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.0167"
                    android:textColor="@color/setup_title"
                    android:textSize="@dimen/setup_text_card_count" />

                <TextView
                    android:id="@+id/setup_progress_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:includeFontPadding="false"
                    android:textColor="@color/setup_heading"
                    android:textSize="@dimen/setup_text_card_label" />
            </LinearLayout>

            <!-- One segment per step; the fragment colours the first "done" segments. -->
            <LinearLayout
                android:id="@+id/setup_progress_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/setup_bar_height"
                android:layout_marginTop="@dimen/setup_bar_top"
                android:importantForAccessibility="no"
                android:orientation="horizontal">

                <View style="@style/Setup.ProgressSegment" />

                <View style="@style/Setup.ProgressSegment.Gap" />

                <View style="@style/Setup.ProgressSegment.Gap" />

                <View style="@style/Setup.ProgressSegment.Gap" />

                <View style="@style/Setup.ProgressSegment.Gap" />
            </LinearLayout>

            <TextView
                android:id="@+id/setup_progress_helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/setup_card_helper_gap"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:lineSpacingExtra="3sp"
                android:textColor="@color/setup_progress_muted"
                android:textSize="@dimen/setup_text_body" />
        </LinearLayout>

        <include
            android:id="@+id/setup_step_profile"
            layout="@layout/setup_step_row"
            android:layout_width="match_parent"
            android:layout_height="@dimen/setup_field_height"
            android:layout_marginTop="@dimen/setup_steps_gap" />

        <include
            android:id="@+id/setup_step_bank"
            layout="@layout/setup_step_row" />

        <include
            android:id="@+id/setup_step_emergency"
            layout="@layout/setup_step_row" />

        <include
            android:id="@+id/setup_step_youtube"
            layout="@layout/setup_step_row" />

        <include
            android:id="@+id/setup_step_identification"
            layout="@layout/setup_step_row" />

        <Button
            android:id="@+id/setup_continue"
            style="@style/Setup.Button"
            android:layout_marginTop="@dimen/setup_continue_gap"
            android:elevation="0dp"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="-0.02"
            android:text="@string/setup_continue"
            android:textSize="@dimen/setup_text_continue" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
