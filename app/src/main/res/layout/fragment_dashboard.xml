<?xml version="1.0" encoding="utf-8"?>
<!-- Entertainer set-up checklist (Figma "Entertainer's Account Setup > Dashboard"). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/setup_background"
    tools:context="com.ebookfrenzy.duvproject.ui.entertainer.DashboardFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/setup_screen_margin"
        android:paddingTop="@dimen/setup_dashboard_top"
        android:paddingEnd="@dimen/setup_screen_margin"
        android:paddingBottom="@dimen/setup_bottom_space">

        <TextView
            android:id="@+id/setup_title"
            style="@style/Setup.Heading"
            android:layout_width="match_parent"
            android:text="@string/setup_title"
            app:lineHeight="@dimen/setup_line_title" />

        <TextView
            android:id="@+id/setup_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/setup_intro_gap"
            android:fontFamily="@font/poppins_medium"
            android:includeFontPadding="false"
            android:letterSpacing="-0.025"
            android:text="@string/setup_intro"
            android:textColor="@color/setup_intro"
            android:textSize="@dimen/setup_text_body"
            app:lineHeight="@dimen/setup_line_body" />

        <TextView
            android:id="@+id/setup_step_profile"
            style="@style/Setup.StepRow"
            android:layout_marginTop="@dimen/setup_steps_gap"
            android:text="@string/entertainer_profile" />

        <TextView
            android:id="@+id/setup_step_bank"
            style="@style/Setup.StepRow"
            android:text="@string/bank_account_details" />

        <TextView
            android:id="@+id/setup_step_emergency"
            style="@style/Setup.StepRow"
            android:text="@string/emergency_contact" />

        <TextView
            android:id="@+id/setup_step_youtube"
            style="@style/Setup.StepRow"
            android:text="@string/youtube_channel" />

        <TextView
            android:id="@+id/setup_step_identification"
            style="@style/Setup.StepRow"
            android:text="@string/valid_identification" />

        <Button
            android:id="@+id/setup_continue"
            style="@style/Setup.Button"
            android:layout_marginTop="@dimen/setup_continue_gap"
            android:elevation="0dp"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="-0.02"
            android:text="@string/setup_continue"
            android:textSize="@dimen/setup_text_continue" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
