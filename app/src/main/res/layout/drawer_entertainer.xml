<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation drawer (Figma "Entertainer's Account Setup > Menu"): Figma's icons, logo, avatar, fonts and colours, with 48dp rows and
     slightly larger text so items are easy to read and tap (see dimens_drawer.xml). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/drawer_width"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/drawer_background"
    android:clickable="true"
    android:fitsSystemWindows="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/drawer_bottom_space">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView style="@style/Drawer.Logo" />

            <ImageView
                android:id="@+id/drawer_close"
                style="@style/Drawer.Close" />
        </FrameLayout>

        <ImageView
            android:id="@+id/drawer_avatar"
            style="@style/Drawer.Avatar" />

        <TextView
            android:id="@+id/drawer_name"
            style="@style/Drawer.Name"
            android:layout_marginTop="@dimen/drawer_name_gap"
            android:text="@string/drawer_name_placeholder" />

        <TextView
            android:id="@+id/drawer_role"
            style="@style/Drawer.Name"
            android:layout_marginTop="@dimen/drawer_role_gap"
            android:text="@string/drawer_role_entertainer" />

        <View
            style="@style/Drawer.Divider"
            android:layout_marginTop="@dimen/drawer_divider_gap" />

        <TextView
            style="@style/Drawer.Label"
            android:text="@string/drawer_navigation" />

        <TextView
            android:id="@+id/drawer_dashboard"
            style="@style/Drawer.Item"
            android:drawableStart="@drawable/ic_drawer_setup_dashboard"
            android:text="@string/dashboard" />

        <TextView
            android:id="@+id/drawer_entertainer_profile"
            style="@style/Drawer.Item.Roboto"
            android:drawableStart="@drawable/ic_drawer_entertainer_profile"
            android:text="@string/entertainer_profile" />

        <TextView
            android:id="@+id/drawer_bank"
            style="@style/Drawer.Item.Roboto"
            android:drawableStart="@drawable/ic_drawer_bank"
            android:text="@string/bank_account_details" />

        <TextView
            android:id="@+id/drawer_emergency"
            style="@style/Drawer.Item.Roboto"
            android:drawableStart="@drawable/ic_drawer_emergency"
            android:text="@string/emergency_contact" />

        <TextView
            android:id="@+id/drawer_youtube"
            style="@style/Drawer.Item.Roboto"
            android:drawableStart="@drawable/ic_drawer_youtube"
            android:text="@string/youtube_channel" />

        <TextView
            android:id="@+id/drawer_identification"
            style="@style/Drawer.Item.Roboto"
            android:drawableStart="@drawable/ic_drawer_identification"
            android:text="@string/valid_identification" />

        <View
            style="@style/Drawer.Divider"
            android:layout_marginTop="@dimen/drawer_section_gap" />

        <TextView
            style="@style/Drawer.Label"
            android:text="@string/drawer_others" />

        <TextView
            android:id="@+id/drawer_switch"
            style="@style/Drawer.Item"
            android:drawableStart="@drawable/ic_drawer_setup_switch"
            android:text="@string/switch_to_user_account" />

        <TextView
            android:id="@+id/drawer_edit_profile"
            style="@style/Drawer.Item"
            android:drawableStart="@drawable/ic_drawer_setup_edit_profile"
            android:text="@string/edit_profile" />

        <TextView
            android:id="@+id/drawer_invite"
            style="@style/Drawer.Item"
            android:drawableStart="@drawable/ic_drawer_setup_invite"
            android:text="@string/invite_friends" />

        <TextView
            android:id="@+id/drawer_logout"
            style="@style/Drawer.Item.Logout"
            android:drawableStart="@drawable/ic_drawer_setup_logout"
            android:text="@string/logout" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
